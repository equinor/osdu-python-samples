# Copy to `.env` and fill in. The OSDU* / AUTH* block is read by osdu-python-client;
# the DEMO_* block is read by these samples. `.env` is gitignored.

# --- osdu-python-client config ---
SERVER=https://your-osdu-instance.com
DATA_PARTITION_ID=your-partition
AUTH_PROVIDER=azure_msal
AUTH_MODE=interactive
CLIENT_ID=<client-id>
AUTHORITY=https://login.microsoftonline.com/<tenant-id>
SCOPES=<app-id-uri>/.default

# --- samples config (DEMO_*) ---
# Read samples need only DEMO_WELLLOG_ID (or pass --id).
DEMO_WELLLOG_ID=<partition>:work-product-component--WellLog:<id>:

# Write samples (opt-in with --write) additionally need:
DEMO_WELLBORE_ID=<partition>:master-data--Wellbore:<id>:
DEMO_LEGAL_TAG=<partition>-...-legaltag
DEMO_ACL_OWNER=data.default.owners@<partition>.<domain>
DEMO_ACL_VIEWER=data.default.viewers@<partition>.<domain>

# Optional: override the bundled typed WellLog data file used by ingest-welllog.
DEMO_WELLLOG_DATA_FILE=
